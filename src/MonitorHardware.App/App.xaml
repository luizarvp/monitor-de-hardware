<Application x:Class="MonitorHardware.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="Surface" Color="#0B1020"/>
      <SolidColorBrush x:Key="Card" Color="#111827"/>
      <SolidColorBrush x:Key="Text" Color="#E5E7EB"/>
      <SolidColorBrush x:Key="Muted" Color="#94A3B8"/>
      <SolidColorBrush x:Key="Primary" Color="#D946EF"/>
      <SolidColorBrush x:Key="Accent" Color="#22D3EE"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
