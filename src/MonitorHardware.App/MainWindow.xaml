<Window x:Class="MonitorHardware.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Monitor Hardware" Width="1100" Height="700" Background="{StaticResource Surface}" Foreground="{StaticResource Text}">
 <DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="MONITOR HARDWARE / WINDOWS HOST" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono" FontSize="12"/><DockPanel><TextBlock Text="Hardware Dashboard" FontSize="30" FontWeight="Bold"/><TextBlock x:Name="Status" DockPanel.Dock="Right" Text="● LIVE" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="20,0"/></DockPanel></StackPanel>
 <Grid Margin="0,28,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
  <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="CPU LOAD" Foreground="{StaticResource Primary}"/><TextBlock x:Name="Cpu" FontSize="34" FontFamily="Cascadia Mono"/><TextBlock x:Name="CpuDetail" Foreground="{StaticResource Muted}"/></StackPanel></Border>
  <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="MEMORY" Foreground="{StaticResource Primary}"/><TextBlock x:Name="Memory" FontSize="34" FontFamily="Cascadia Mono"/><TextBlock x:Name="MemoryDetail" Foreground="{StaticResource Muted}"/></StackPanel></Border>
  <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="GPU ADAPTER" Foreground="{StaticResource Primary}"/><TextBlock x:Name="Gpu" FontSize="25" TextWrapping="Wrap"/><TextBlock x:Name="SystemInfo" Foreground="{StaticResource Muted}"/></StackPanel></Border>
  <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="FIXED DISKS" Foreground="{StaticResource Primary}"/><ItemsControl x:Name="Disks"/></StackPanel></Border>
  <TextBlock x:Name="Footer" Grid.Row="2" Grid.ColumnSpan="2" Foreground="{StaticResource Muted}" Margin="8,25"/>
 </Grid></DockPanel>
</Window>
